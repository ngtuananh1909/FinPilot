# Copy to .env.local; fill values MANUALLY. NEVER COMMIT actual secrets.
# All local app and AWS-hosted app traffic must target the SAME Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret, reserved for explicit admin actions / atomic quota ops.
# NEVER use in client or expose in NEXT_PUBLIC_*. Don't set in browser scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Provider: gemini | openrouter. User chooses base URL/API key/model at integration time.
# Gemini (OpenAI-compatible): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Tested 2026-11-24 with tools + vision: gemini-3.5-flash-lite (recommended), gemini-4-hydrogen.
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1 ; tested: nvidia/nemotron-3.5-super-vl:free for BOTH
#   models (slower: use AI_TIMEOUT_MS=45000). Vision model must READ images (input image), not generate them.
# Check with: npm run ai:probe   (expects tools=true vision=true)
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_TOOL_STEPS=4

# Server-enforced quotas and upload limits. Timezone: Asia/Ho_Chi_Minh.
GUEST_CHAT_DAILY_LIMIT=20
GUEST_SCAN_DAILY_LIMIT=5
RECEIPT_MAX_BYTES=5242880
CSV_MAX_BYTES=2097152

# Public app base for auth redirect/callback configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional DEMO seed credentials: set only in your secure local/admin environment,
# never deploy these SEED_* variables to Amplify; do not store passwords in repository.
# SEED_USER_1_EMAIL=
# SEED_USER_1_PASSWORD=
# SEED_USER_2_EMAIL=
# SEED_USER_2_PASSWORD=
# SEED_USER_3_EMAIL=
# SEED_USER_3_PASSWORD=
